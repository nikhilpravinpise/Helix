# Copy this file to .env and fill in real values. Never commit .env.
HELIX_ENVIRONMENT=development
HELIX_LOG_LEVEL=INFO

# LLM provider (D14): OpenAI-compatible. Defaults to Groq's free tier.
# Get a key at https://console.groq.com - or point BASE_URL at a local
# Ollama (http://localhost:11434/v1) or any OpenAI-compatible endpoint.
HELIX_LLM_API_KEY=gsk-your-key-here
# Optional extra keys, comma-separated, tried in order when a key is
# rate-limited or rejected. HELIX_LLM_API_KEY stays key 1. Groq's limits are
# per organization: keys from the same org share one daily budget.
HELIX_LLM_API_KEYS=
HELIX_LLM_BASE_URL=https://api.groq.com/openai/v1
HELIX_LLM_MODEL=openai/gpt-oss-120b

# Evidence layer (subphase 1.3)
# Read-only GitHub token scoped to HELIX_GITHUB_REPO (D5); least privilege.
HELIX_GITHUB_TOKEN=
HELIX_GITHUB_REPO=nikhilpravinpise/Helix
# Jenkins runs on the host (D1); user/token match infra/jenkins setup.
HELIX_JENKINS_URL=http://localhost:8080
HELIX_JENKINS_USER=admin
HELIX_JENKINS_TOKEN=admin-sandbox-placeholder
# Host Elasticsearch used by the ELK evidence capability (CF-3).
HELIX_ES_URL=http://localhost:9200
# kind context for the sandbox cluster.
HELIX_KUBE_CONTEXT=kind-helix-sandbox
# "live" uses vendor clients; "fixtures" replays a recorded fixture.
HELIX_EVIDENCE_SOURCE=live
# Required in fixtures mode: path to a fixture JSON or a fault name under
# fixtures/faults/ (the benchmark harness sets this per scenario).
HELIX_FIXTURE_PATH=

# Incident state + intake (subphase 1.4)
# Host Postgres from infra/postgres-compose.yml (D3) - full SQLAlchemy URL.
# Literal 127.0.0.1, not localhost: the compose port is IPv4-loopback only,
# and on Windows "localhost" resolves IPv6-first and stalls connecting.
HELIX_DATABASE_URL=postgresql+psycopg://helix:helix@127.0.0.1:5432/helix

# Kafka backbone (subphase E2) from infra/kafka-compose.yml. Literal
# 127.0.0.1 for the same reason as above, and the broker advertises that
# address too - advertising "localhost" makes clients re-resolve it,
# try IPv6 ::1 first, and be refused.
HELIX_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Retrieval over incident history (subphase E6). OFF by default on
# purpose: the flag exists so retrieval's effect on diagnosis is measured
# rather than assumed. Ablation arm C turns it on for itself regardless.
HELIX_RETRIEVAL_ENABLED=false
HELIX_RETRIEVAL_LIMIT=3

# Where `helix serve` listens. 8787 avoids payment-api 8000, Jenkins 8080,
# Elasticsearch 9200.
# Loopback is right on Docker Desktop, where containers reach the host via
# host.docker.internal. On Linux a container cannot reach the host's
# loopback, so bind the docker0 bridge instead - Jenkins' post-failure
# intake call can then reach Helix, and nothing off this machine can:
#   HELIX_API_BIND=172.17.0.1   (check with: ip -4 addr show docker0)
HELIX_API_BIND=127.0.0.1
HELIX_API_PORT=8787
# Optional shared secret for intake POSTs (`Authorization: Bearer <token>`).
# Leave empty for local-only trust.
HELIX_INTAKE_TOKEN=

# Coordinator + diagnosis (subphase 1.5)
# Cap on LLM request-more-evidence rounds per diagnosis; bounds investigation.
HELIX_MAX_EVIDENCE_ROUNDS=3
# Ablation arm / graph composition (D8): E=full graph, B=single LLM call
# (diagnosis+planning fused, no validate/verify/replan), A=deterministic
# rule tables instead of LLM nodes, C=B plus retrieval (E6) - the same
# single call given prior resolved incidents, so C-vs-B isolates what RAG
# buys over a bare LLM. A and B land in 1.11, C in E6.
HELIX_ARM=E

# Safety policy + execution (subphase 1.8)
# Comma-separated kube contexts the write path may mutate; anything else is
# refused in the client even when policy would allow.
HELIX_ALLOWED_KUBE_CONTEXTS=kind-helix-sandbox
# Default approver identity for `helix approve`/`helix reject` decisions
# (--actor overrides; the API takes `actor` in the request body).
HELIX_OPERATOR=operator

# Verification agent (subphase 1.9)
# Seconds the post-action desired state must hold before an incident may
# close; sampled every HELIX_VERIFY_POLL seconds. A pod that was Ready then
# is not - inside the window - counts as flapping, not recovered.
HELIX_VERIFY_WINDOW=60
HELIX_VERIFY_POLL=20
# Settle budget (seconds): deployment-mutating actions first wait for the
# rollout to converge, so intended pod turnover is not sampled as flapping.
HELIX_VERIFY_SETTLE=120
# Error-level ELK log lines allowed in a poll-sized post-action window.
# 0 means any fresh ERROR fails the check.
HELIX_ELK_ERROR_THRESHOLD=0
# Functional leg: browser /docs load + POST /payments round-trip. Required
# in live benchmark mode; set false for headless/CI contexts (recorded as
# skipped, never as passed). Always skipped in fixture mode - there is no
# live service to probe.
HELIX_VERIFY_FUNCTIONAL=true
# How the functional leg reaches the service (1.13). Empty = kubectl
# port-forward svc/<service> (any cluster). Set to the ingress base URL to
# verify through the same surface operators use - on the kind sandbox that
# is http://payment-api.local, which needs a hosts-file entry mapping the
# name to 127.0.0.1 (see docs/bring-up.md).
HELIX_VERIFY_BASE_URL=

# Unhappy paths + bounded recovery (subphase 1.10)
# Per-incident retry budget: how many diagnose->...->verify cycles an
# incident may consume (initial run plus rediagnoses/replans) before the
# coordinator escalates instead of retrying again.
HELIX_MAX_ATTEMPTS=3
# Seconds a pending approvals row may sit undecided before the run sweep
# rejects it as timed out and escalates the incident. 0 disables.
HELIX_APPROVAL_TIMEOUT=86400
# Wall-clock bound on a single graph node inside a run; a node still
# running at the deadline fails the run (recorded as a node failure).
# 0 disables.
HELIX_STEP_TIMEOUT=600

# Relationship graph (subphase 2.7). Off by default - Triage/Review's
# pre-graph heuristics stay the exit criterion's comparison baseline
# until this is turned on deliberately.
HELIX_GRAPH_ENABLED=false
HELIX_NEO4J_URI=bolt://127.0.0.1:7687
HELIX_NEO4J_USER=neo4j
HELIX_NEO4J_PASSWORD=neo4j-sandbox-placeholder
HELIX_NEO4J_DATABASE=neo4j

# Slack (subphase 2.2). Both empty means notify/approve is a recorded
# no-op, never a crash - "Slack outage does not lose the decision".
HELIX_SLACK_BOT_TOKEN=
HELIX_SLACK_SIGNING_SECRET=
# App-level token for Socket Mode (`helix slack-socket`): Slack app settings ->
# Socket Mode -> enable -> token with scope connections:write. Lets the
# Approve/Reject buttons work with no public URL into this machine.
HELIX_SLACK_APP_TOKEN=
HELIX_SLACK_DEFAULT_CHANNEL=#helix-incidents
HELIX_SLACK_APPROVAL_TIMEOUT=

# Work management (subphase 2.3/2.10). "memory" runs the in-process
# recording provider (tests, fixture-mode benchmark runs); jira/linear/
# trello need their own credentials below.
HELIX_WORK_PROVIDER=memory
HELIX_JIRA_BASE_URL=https://example.atlassian.net
HELIX_JIRA_EMAIL=helix-bot@example.com
HELIX_JIRA_API_TOKEN=
HELIX_JIRA_PROJECT_KEY=HELIX
HELIX_LINEAR_API_KEY=
HELIX_LINEAR_TEAM_ID=
HELIX_TRELLO_API_KEY=
HELIX_TRELLO_API_TOKEN=
HELIX_TRELLO_BOARD_ID=

# Notion (subphase 2.4).
HELIX_NOTION_API_KEY=
HELIX_NOTION_PARENT_PAGE_ID=

# --- Infrastructure / CI tooling (subphase 1.13) -------------------------
# Not a HELIX_ setting - consumed by infra/jenkins-compose.yml (and the
# Terraform equivalent, as TF_VAR_sonarqube_token) to seed the JCasC
# `sonarqube-token` credential. Generate a real token in the SonarQube UI:
# http://127.0.0.1:9000 -> admin/admin -> My Account -> Security ->
# Generate Token. Empty until then.
SONARQUBE_TOKEN=
