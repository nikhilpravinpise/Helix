// Builds, tests, containerizes and deploys sandbox/payment-api (ticket #5).
// Single node, no agents, no multi-branch: this pipeline has one job to do.
//
// The Helix repo is bind-mounted read-only into this container at
// /workspace/helix-src (see infra/jenkins-compose.yml), so every stage
// below reads the live working tree, including uncommitted changes. That
// is deliberate: proving the pipeline fails on a broken test or a broken
// Dockerfile means running it against an uncommitted edit, not a commit.
//
// Docker and the kind cluster are reached as described in
// infra/jenkins-compose.yml and infra/jenkins/Dockerfile:
//   - docker CLI talks to the host's own Docker daemon via the bind-mounted
//     socket (this container is a sibling of the kind node container, not
//     a nested dind).
//   - kubectl talks to the cluster via a kubeconfig generated on demand
//     with `kind get kubeconfig --internal`, which points at the kind
//     control-plane container's own name and port on the "kind" Docker
//     network this container is attached to.
pipeline {
    agent any

    environment {
        SRC          = '/workspace/helix-src/sandbox/payment-api'
        BUILD_DIR    = "${WORKSPACE}/payment-api"
        IMAGE_TAG    = 'payment-api:kind'
        CLUSTER_NAME = 'helix-sandbox'
        NAMESPACE    = 'payment-api'
    }

    stages {
        stage('Install dependencies') {
            steps {
                script { env.HELIX_STAGE = env.STAGE_NAME }  // read by post { failure }
                sh '''
                    set -euo pipefail
                    rm -rf "${BUILD_DIR}"
                    cp -r "${SRC}" "${BUILD_DIR}"
                    cd "${BUILD_DIR}"
                    uv sync --group dev
                '''
            }
        }

        stage('Test') {
            steps {
                script { env.HELIX_STAGE = env.STAGE_NAME }  // read by post { failure }
                sh '''
                    set -euo pipefail
                    cd "${BUILD_DIR}"
                    uv run pytest -v --cov=payment_api --cov-report=xml:coverage.xml
                '''
            }
        }

        // Subphase 1.13 - the quality gate. The scan runs through the
        // sonarsource/sonar-scanner-cli image rather than a Jenkins tool
        // installation: SonarScanner 8.x needs Java 21 while this image is
        // jdk17, and the container carries its own runtime and reuses the
        // same docker socket wiring the Build stage already relies on.
        //
        // Guard semantics: SonarQube is an optional stack on this
        // memory-tight host (infra/sonarqube-compose.yml, CF-4). When the
        // server is not reachable the stages log and SKIP - the pipeline
        // stays usable without it. But when the analysis DOES run, the
        // gate is hard: waitForQualityGate abortPipeline fails the build
        // on a FAILED/ERROR quality gate, before any image is built or
        // deployed.
        stage('SonarQube analysis') {
            steps {
                script { env.HELIX_STAGE = env.STAGE_NAME }  // read by post { failure }
                script {
                    env.SONAR_ANALYZED = 'false'
                    def sonarUp = sh(
                        returnStatus: true,
                        script: 'curl -sf --max-time 5 http://host.docker.internal:9000/api/system/status | grep -q \'"status":"UP"\''
                    )
                    if (sonarUp != 0) {
                        echo 'SonarQube not reachable on host.docker.internal:9000 - analysis and quality gate skipped. Start infra/sonarqube-compose.yml to enable.'
                    } else {
                        // withSonarQubeEnv injects SONAR_HOST_URL/SONAR_TOKEN
                        // from the `helix-sonarqube` installation (JCasC) and
                        // records the CE task so waitForQualityGate below can
                        // find it.
                        //
                        // Mount note: docker -v paths resolve on the HOST
                        // daemon, so ${BUILD_DIR} (a path inside this
                        // container) cannot be bind-mounted. --volumes-from
                        // this container instead exposes the jenkins-home
                        // volume at the SAME absolute path - the scanner's
                        // .scannerwork/report-task.txt lands in the Jenkins
                        // workspace, which is how waitForQualityGate finds
                        // the task (it reads the "Working dir:" line the
                        // scanner prints, then the report file).
                        withSonarQubeEnv('helix-sonarqube') {
                            // The plugin injects SONAR_HOST_URL +
                            // SONAR_AUTH_TOKEN; the scanner image's env var
                            // is SONAR_TOKEN - map it through.
                            //
                            // SCANNER_WORKDIR_PATH -> -Dsonar.working.
                            // directory (the image's entrypoint maps it).
                            // It must be INSIDE the workspace: the plugin
                            // parses the scanner's "Working dir:" log line
                            // and reads report-task.txt at that absolute
                            // path to hand the CE task id to
                            // waitForQualityGate. --volumes-from puts the
                            // jenkins-home volume at the same path in both
                            // containers, and the scanner runs as uid 1000
                            // (same as jenkins) so the write lands.
                            // SONAR_USER_HOME in the workspace keeps the
                            // provisioned-JRE/plugin cache between builds.
                            sh '''
                                docker run --rm \
                                  --volumes-from "$(hostname)" \
                                  -e SONAR_HOST_URL="${SONAR_HOST_URL}" \
                                  -e SONAR_TOKEN="${SONAR_AUTH_TOKEN:-${SONAR_TOKEN:-}}" \
                                  -e SONAR_USER_HOME="${BUILD_DIR}/.sonar" \
                                  -e SCANNER_WORKDIR_PATH="${BUILD_DIR}/.scannerwork" \
                                  -w "${BUILD_DIR}" \
                                  sonarsource/sonar-scanner-cli:12.1.0.3233_8.0.1
                            '''
                        }
                        env.SONAR_ANALYZED = 'true'
                    }
                }
            }
        }

        stage('Quality Gate') {
            when {
                expression { env.SONAR_ANALYZED == 'true' }
            }
            steps {
                script { env.HELIX_STAGE = env.STAGE_NAME }  // read by post { failure }
                timeout(time: 10, unit: 'MINUTES') {
                    // Hard gate: aborted (failed) gate fails the build.
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build image') {
            steps {
                script { env.HELIX_STAGE = env.STAGE_NAME }  // read by post { failure }
                sh '''
                    set -euo pipefail
                    docker build --provenance=false -t "${IMAGE_TAG}" "${SRC}"
                '''
            }
        }

        stage('Deploy to kind') {
            steps {
                script { env.HELIX_STAGE = env.STAGE_NAME }  // read by post { failure }
                sh '''
                    set -euo pipefail

                    KUBECONFIG_FILE="$(mktemp)"
                    PF_PID=""
                    cleanup() {
                        [ -n "${PF_PID}" ] && kill "${PF_PID}" 2>/dev/null || true
                        rm -f "${KUBECONFIG_FILE}"
                    }
                    trap cleanup EXIT

                    # Internal kubeconfig: points at the control-plane
                    # container's own name and port 6443, reachable because
                    # this container shares the "kind" Docker network - not
                    # the host-published port kind also exposes, which is
                    # bound to 127.0.0.1 on the host and therefore
                    # unreachable from inside this container.
                    kind get kubeconfig --name "${CLUSTER_NAME}" --internal > "${KUBECONFIG_FILE}"
                    export KUBECONFIG="${KUBECONFIG_FILE}"

                    NODE="$(kind get nodes --name "${CLUSTER_NAME}" | head -1)"
                    docker save --platform linux/amd64 "${IMAGE_TAG}" \
                      | docker exec -i "${NODE}" ctr --namespace=k8s.io images import --digests --snapshotter=overlayfs -

                    kubectl -n "${NAMESPACE}" rollout restart deployment/payment-api
                    kubectl -n "${NAMESPACE}" rollout status deployment/payment-api --timeout=120s

                    kubectl -n "${NAMESPACE}" port-forward svc/payment-api :8000 >/tmp/jenkins-pf.log 2>&1 &
                    PF_PID=$!

                    PORT=""
                    for i in $(seq 1 30); do
                        PORT="$(sed -n 's/.*127\\.0\\.0\\.1:\\([0-9]\\{1,\\}\\).*/\\1/p' /tmp/jenkins-pf.log | head -1)"
                        [ -n "${PORT}" ] && break
                        sleep 1
                    done
                    [ -n "${PORT}" ] || { echo "port-forward never reported a local port" >&2; exit 1; }

                    STATUS=""
                    for i in $(seq 1 30); do
                        STATUS="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://localhost:${PORT}/ready" || true)"
                        [ "${STATUS}" = "200" ] && break
                        sleep 1
                    done

                    if [ "${STATUS}" != "200" ]; then
                        echo "deploy verification failed: /ready did not return 200 (last status: ${STATUS:-none})" >&2
                        exit 1
                    fi

                    echo "deploy verified: /ready is 200"
                '''
            }
        }
    }

    post {
        failure {
            // Notify Helix intake (decision D6, push model). The intake API
            // runs on the host; host.docker.internal resolves to it from
            // this container on Docker Desktop. catchError plus `|| true`:
            // intake being down must NEVER change the pipeline outcome - a
            // signal that cannot be delivered is lost, not retried.
            // signature.job + signature.stage are the dedup fingerprint's
            // jenkins fields, and the rule tables key on the stage. Inside
            // post, STAGE_NAME is "Declarative: Post Actions", not the stage
            // that failed, so every stage records itself in HELIX_STAGE.
            // `?run=true` makes Helix act on the signal, not only record it;
            // the intake answers at once and runs in the background.
            catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                // The payload is single-quoted: ${STAGE_NAME} can contain
                // spaces ("Declarative: Post Actions") and unquoted it used
                // to split into separate curl arguments. catchError +
                // `|| true` still guarantee intake being down never fails
                // the build.
                sh '''
                    curl -sS --max-time 10 -o /dev/null -X POST \
                      -H 'Content-Type: application/json' \
                      -d '{"source":"jenkins","service":"payment-api","environment":"sandbox","signature":{"job":"'"${JOB_NAME}"'","stage":"'"${HELIX_STAGE:-unknown}"'"},"raw":{"job":"'"${JOB_NAME}"'","build_number":'"${BUILD_NUMBER}"',"build_url":"'"${BUILD_URL}"'"}}' \
                      'http://host.docker.internal:8787/intake/jenkins?run=true' || true
                '''
            }
        }
    }
}
